# Copy to .env.local for local development. NEVER commit real keys.
# On Vercel: Project Settings -> Environment Variables.

# Required for AI ideas. Without it the app still returns the full rules-based plan.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Optional: shared rate limiting across serverless instances (Upstash Redis REST).
# Set both or neither. Without them, rate limiting is per instance, in memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
